# Copy to .env and `source` it (or export) to configure the LLM backend.
# Defaults run everything offline with a deterministic mock — no key required.

# mock | real
LLM_MODE=mock

# Required only when LLM_MODE=real. No model string is ever hardcoded in code.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Docker gateway backend URLs (used by generated/gateway at runtime).
MONOLITH_URL=http://monolith:8000
ORDERS_URL=http://orders-service:8000
